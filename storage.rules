rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Archivos de cursos (módulos y lecciones) - solo admins/trainers pueden subir
    match /courses/{courseId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Archivos de certificados y logos - solo admins
    match /certificates/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Regla por defecto: denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
