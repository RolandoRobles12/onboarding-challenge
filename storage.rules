rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Archivos de cursos (módulos y lecciones)
    match /courses/{courseId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Videos del feed (solo admins/trainers pueden subir, todos los autenticados pueden leer)
    match /videos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Archivos de certificados y logos
    match /certificates/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Logo de marca (Admin > Marca)
    match /branding/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Capturas de pantalla del prototipo de simulaciones por nodos
    match /simulations/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Regla por defecto: denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
