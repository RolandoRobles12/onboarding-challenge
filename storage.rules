rules_version = '2';

// Lectura: cuentas permitidas (mismo criterio que firestore.rules).
// Escritura: solo staff (super_admin, admin, trainer); todas las subidas salen
// del panel de administración.
service firebase.storage {
  match /b/{bucket}/o {

    function allowedAccount() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && (request.auth.token.email.lower().matches('.*@avivacredito[.]com')
            || request.auth.token.email.lower() in ['rolando.9834@gmail.com']);
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return allowedAccount()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profile().get('active', true) != false
        && profile().get('rol', '') in ['super_admin', 'admin', 'trainer'];
    }

    // Archivos de cursos, videos del feed, certificados, logo de marca y
    // capturas de las simulaciones.
    match /{folder}/{allPaths=**} {
      allow read: if folder in ['courses', 'videos', 'certificates', 'branding', 'simulations']
        && allowedAccount();
      allow write: if folder in ['courses', 'videos', 'certificates', 'branding', 'simulations']
        && isStaff();
    }
  }
}
